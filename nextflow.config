manifest {
    name            = 'oucru-id/DENV-to-fhir-full'
    description     = 'Dengue virus WGS/amplicon sequencing to serotyping, masked consensus, Nextclade genotyping and HL7 FHIR Genomics reports'
    homePage        = 'https://github.com/oucru-id/DENV-to-fhir-full'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '2.0.0'
    license         = 'MIT'
}

plugins {
    id 'nf-schema@2.5.1'
}

params {
    input       = null      // samplesheet: sample,platform,fastq_1,fastq_2,fasta
    reads_dir   = null      // legacy: <id>_{1,2}_illumina.fastq.gz, <id>_ont.fastq.gz, <id>.fasta
    outdir      = 'results'
    results_dir = null      // deprecated in 2.0.0; use --outdir

    reference_dir   = "${projectDir}/data/references"
    reference_panel = "${projectDir}/data/references/panel.tsv"

    trimmomatic_jar    = null
    nanopore_min_q     = 7
    nanopore_min_l     = 200
    skip_host_removal  = false
    hostile_index      = null
    hostile_index_name = 'human-t2t-hla'

    primer_bed             = null
    ivar_min_quality       = 20
    ivar_min_length        = 30
    ivar_include_no_primer = true
    medaka_model           = null
    medaka_batch_size      = 100

    consensus_min_depth = 10
    consensus_min_af    = 0.5
    variant_min_quality = 20
    mpileup_max_depth   = 10000

    min_serotype_reads       = 10
    coinfection_min_fraction = 0.10
    nextclade_dir            = null
    nextclade_dataset_tag    = null
    min_completeness         = 0.80

    fhir_profile           = 'generic'   // generic | satusehat
    fhir_include_sequence  = true
    performer_org_id       = null
    performer_org_name     = null
    identifier_system_base = null
    patient_metadata       = null
    organization_metadata  = null
    practitioner_metadata  = null
    external_refs          = null
    require_clinical       = false
    bundle_request_method  = 'PUT'       // PUT | POST
    publish_clinical       = true

    skip_fhir_validation       = true
    fhir_validator             = 'https://github.com/hapifhir/org.hl7.fhir.core/releases/download/6.5.26/validator_cli.jar'
    fhir_ig                    = 'hl7.fhir.uv.genomics-reporting#3.0.0'
    fhir_tx_server             = 'n/a'
    fail_on_validation_error   = null
    fhir_validation_batch_size = 50

    fhir_server_url     = null
    fhir_auth_url       = null
    fhir_upload_api_key = false

    max_cpus   = Math.min(8, Runtime.runtime.availableProcessors())
    max_memory = '16 GB'
    max_time   = '24h'

    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    test_stub {
        includeConfig 'conf/test_stub.config'
    }
    test_fasta {
        includeConfig 'conf/test_fasta.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    podman {
        podman.enabled      = true
        conda.enabled       = false
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        apptainer.enabled      = false
        podman.enabled         = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
    }
    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
